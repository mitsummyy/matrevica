<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=1024">
  <title>Matrevica</title>
  <script src="https://unpkg.com/lucide@latest"></script>
  <style>
    :root {
      --fundo-dark: #130f1e;
      --card-bg: #1e172e;
      --lilas-fofo: #d8b4fe;
      --lilas-suave: #e9d5ff;
      --lilas-escuro: #2a1b40;
      --borda-dark: #3b2063;
      --borda-destaque: #6b21a8;
      --texto-claro: #f3e8ff;
      --texto-escuro: #2e1065;
    }

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
      font-family: 'Courier New', Courier, monospace, sans-serif;
    }

    body {
      background-color: var(--fundo-dark);
      background-image: 
        linear-gradient(to right, #241838 1px, transparent 1px),
        linear-gradient(to bottom, #241838 1px, transparent 1px);
      background-size: 20px 20px;
      color: var(--texto-claro);
      padding: 2rem 1rem;
      max-width: 900px;
      margin: 0 auto;
      line-height: 1.6;
      letter-spacing: 0.2px;
    }

    /* ESTILO DAS JANELAS RETRÔ */
    .retro-window {
      background: var(--card-bg);
      border: 2px solid var(--borda-destaque);
      box-shadow: 4px 4px 0px var(--borda-dark);
      margin-bottom: 1.5rem;
      border-radius: 6px;
      overflow: hidden;
    }

    .window-header {
      background: var(--lilas-fofo);
      color: var(--texto-escuro);
      padding: 0.4rem 0.8rem;
      border-bottom: 2px solid var(--borda-destaque);
      display: flex;
      justify-content: center;
      align-items: center;
      font-weight: bold;
      font-size: 0.85rem;
      letter-spacing: 1px;
    }

    .window-body {
      padding: 1.2rem;
    }

    /* TOPO CENTRALIZADO COM LUA ABAIXO */
    .top-header {
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      margin-bottom: 1.8rem;
      gap: 0.6rem;
    }

    .tag-title {
      background: var(--card-bg);
      border: 2px solid var(--borda-destaque);
      box-shadow: 3px 3px 0px var(--borda-dark);
      padding: 0.5rem 1.2rem;
      font-weight: bold;
      font-size: 0.85rem;
      color: var(--lilas-suave);
      text-align: center;
      letter-spacing: 0.5px;
    }

    .moon-icon-below {
      display: flex;
      align-items: center;
      justify-content: center;
    }

    /* GRELHA PRINCIPAL */
    .main-grid {
      display: grid;
      grid-template-columns: 260px 1fr;
      gap: 1.5rem;
    }

    @media (max-width: 768px) {
      .main-grid {
        grid-template-columns: 1fr;
      }
    }

    /* PERFIL */
    .profile-avatar-container {
      text-align: center;
      margin-bottom: 1.2rem;
      display: flex;
      justify-content: center;
      align-items: center;
    }

    .profile-avatar-svg {
      width: 140px;
      height: 140px;
      border-radius: 50%;
      border: 3px solid var(--lilas-fofo);
      box-shadow: 0 0 15px rgba(216, 180, 254, 0.4);
    }

    .bio-box {
      border: 2px solid var(--borda-destaque);
      background: var(--lilas-escuro);
      padding: 0.9rem;
      font-size: 0.8rem;
      line-height: 1.6;
      border-radius: 4px;
      color: var(--lilas-suave);
      text-align: justify;
      letter-spacing: 0.2px;
    }

    /* BOTÕES DE STATUS NO PERFIL */
    .user-icon-status-container {
      display: flex;
      justify-content: center;
      align-items: center;
      gap: 0.8rem;
      margin-top: 1.2rem;
    }

    .user-avatar-btn {
      width: 42px;
      height: 42px;
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      cursor: pointer;
      box-shadow: 2px 2px 0px var(--borda-dark);
      transition: all 0.3s ease;
    }

    .user-avatar-btn.logged-out {
      background: #000000;
      border: 2px solid var(--lilas-fofo);
    }
    .user-avatar-btn.logged-out svg {
      stroke: var(--lilas-fofo);
    }

    .user-avatar-btn.logged-in {
      background: var(--lilas-fofo);
      border: 2px solid var(--borda-destaque);
    }
    .user-avatar-btn.logged-in svg {
      stroke: var(--texto-escuro);
    }

    /* CARD LILÁS COM TEXTO PRETO */
    .welcome-card-purple {
      background: var(--lilas-fofo);
      border: 2px solid var(--borda-destaque);
      box-shadow: 4px 4px 0px var(--borda-dark);
      border-radius: 6px;
      padding: 1.4rem;
      margin-bottom: 1.5rem;
      color: #000000;
      font-size: 0.9rem;
      line-height: 1.7;
      letter-spacing: 0.2px;
    }

    .button-group {
      display: flex;
      gap: 0.6rem;
      margin-top: 1.2rem;
      border-top: 2px dashed rgba(0, 0, 0, 0.2);
      padding-top: 0.9rem;
    }

    .mini-btn {
      background: var(--card-bg);
      color: var(--lilas-suave);
      border: 1px solid var(--borda-destaque);
      box-shadow: 2px 2px 0px var(--texto-escuro);
      padding: 0.4rem 0.9rem;
      font-size: 0.75rem;
      font-weight: bold;
      border-radius: 3px;
      cursor: pointer;
      letter-spacing: 0.5px;
    }

    .mini-btn:hover {
      background: var(--borda-dark);
      color: #ffffff;
    }

    /* SEÇÃO INFERIOR */
    .bottom-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 1.2rem;
    }

    @media (max-width: 500px) {
      .bottom-grid {
        grid-template-columns: 1fr;
      }
    }

    .update-item {
      font-size: 0.82rem;
      display: flex;
      gap: 0.6rem;
      margin-bottom: 0.8rem;
      border-bottom: 1px solid var(--lilas-escuro);
      padding-bottom: 0.5rem;
      cursor: pointer;
      transition: color 0.2s;
      align-items: center;
      letter-spacing: 0.3px;
    }

    .update-item:last-child {
      margin-bottom: 0;
      border-bottom: none;
    }

    .update-item:hover {
      color: var(--lilas-fofo);
    }

    .update-date {
      font-weight: bold;
      background: var(--lilas-escuro);
      color: var(--lilas-fofo);
      padding: 0.1rem 0.4rem;
      height: fit-content;
      border: 1px solid var(--borda-destaque);
      border-radius: 3px;
      font-size: 0.75rem;
      letter-spacing: 0.5px;
    }

    .ficha-card-item {
      background: var(--lilas-escuro);
      border: 1px solid var(--borda-destaque);
      padding: 0.7rem;
      margin-bottom: 0.7rem;
      border-radius: 4px;
      cursor: pointer;
      transition: all 0.2s;
    }

    .ficha-card-item:last-child {
      margin-bottom: 0;
    }

    .ficha-card-item:hover {
      background: var(--borda-dark);
      border-color: var(--lilas-fofo);
    }

    .ficha-title {
      font-weight: bold;
      color: var(--lilas-fofo);
      font-size: 0.82rem;
      margin-bottom: 0.2rem;
      letter-spacing: 0.3px;
    }

    .ficha-sub {
      font-size: 0.72rem;
      color: var(--lilas-suave);
    }

    /* MODAIS DA PÁGINA */
    .modal {
      display: none;
      position: fixed;
      inset: 0;
      background: rgba(10, 5, 20, 0.88);
      backdrop-filter: blur(4px);
      align-items: center;
      justify-content: center;
      z-index: 200;
      padding: 1rem;
    }

    .modal-content {
      background: var(--card-bg);
      border: 2px solid var(--borda-destaque);
      box-shadow: 6px 6px 0px var(--borda-dark);
      border-radius: 8px;
      padding: 1.5rem;
      width: 100%;
      max-width: 550px;
      max-height: 85vh;
      overflow-y: auto;
      position: relative;
    }

    .close-btn {
      position: absolute;
      top: 0.8rem;
      right: 0.8rem;
      background: var(--lilas-fofo);
      color: var(--texto-escuro);
      border: none;
      font-weight: bold;
      padding: 0.2rem 0.5rem;
      cursor: pointer;
      border-radius: 3px;
      z-index: 300;
    }

    .form-group {
      margin-bottom: 1.2rem;
    }

    .form-group label {
      display: block;
      font-size: 0.8rem;
      margin-bottom: 0.4rem;
      color: var(--lilas-fofo);
      letter-spacing: 0.3px;
    }

    .form-group input, .form-group textarea, .form-group select {
      width: 100%;
      padding: 0.6rem;
      background: var(--fundo-dark);
      border: 1px solid var(--borda-destaque);
      color: var(--texto-claro);
      border-radius: 4px;
      font-family: inherit;
      letter-spacing: 0.3px;
    }

    .bat-rating {
      display: flex;
      gap: 0.5rem;
      margin-top: 0.3rem;
    }

    .bat-star {
      font-size: 1.5rem;
      cursor: pointer;
      filter: grayscale(100%) opacity(0.3);
      transition: all 0.2s;
    }

    .bat-star.active {
      filter: grayscale(0%) drop-shadow(0 0 6px rgba(0,0,0,0.9));
      color: #000000;
      text-shadow: 0 0 8px #d8b4fe;
    }

    .comments-scroll-container {
      max-height: 250px;
      overflow-y: auto;
      padding-right: 0.5rem;
      margin-top: 0.8rem;
    }

    .comentario-box {
      background: var(--lilas-escuro);
      border-left: 3px solid var(--lilas-fofo);
      padding: 0.8rem;
      margin-bottom: 0.8rem;
      font-size: 0.8rem;
      border-radius: 3px;
      line-height: 1.5;
      letter-spacing: 0.2px;
    }

    .comentario-header {
      display: flex;
      justify-content: space-between;
      margin-bottom: 0.4rem;
      font-size: 0.75rem;
    }

    .comentario-autor {
      font-weight: bold;
      color: var(--lilas-fofo);
      letter-spacing: 0.3px;
    }

    .comentario-data {
      color: var(--lilas-suave);
      font-size: 0.68rem;
    }

    .error-msg-minimal {
      color: #f87171;
      font-size: 0.75rem;
      text-align: center;
      margin-top: 0.5rem;
      display: none;
    }

    .ficha-secao {
      border-top: 1px dotted var(--borda-destaque);
      margin-top: 1rem;
      padding-top: 0.8rem;
    }

    .ficha-secao h4 {
      color: var(--lilas-fofo);
      font-size: 0.85rem;
      margin-bottom: 0.4rem;
      letter-spacing: 0.3px;
    }

    .bat-outline-animation {
      display: flex;
      justify-content: center;
      align-items: center;
      margin-bottom: 0.5rem;
    }

    .bat-outline-svg {
      width: 48px;
      height: 48px;
      stroke: #000000;
      fill: none;
      stroke-width: 2;
    }

    /* ====== LEITOR DIGITAL DE POSTAGENS ====== */
    .reader-modal-body {
      background: #0a0a0a !important;
      border: 2px solid var(--borda-destaque) !important;
      padding: 0 !important;
      max-width: 800px !important;
      height: 85vh !important;
      overflow: hidden !important;
      position: relative;
    }

    .reader {
      display: flex;
      height: 100%;
      width: 100%;
      overflow-x: auto;
      overflow-y: hidden;
      scroll-snap-type: x mandatory;
      scroll-behavior: smooth;
      -webkit-overflow-scrolling: touch;
      scrollbar-width: none;
      font-family: 'PMN Caecilia', 'PMN Caecilia LT', 'Caecilia', Georgia, 'Times New Roman', serif;
      color: #d6d2c8;
    }
    .reader::-webkit-scrollbar { display: none; }

    .reader-page {
      flex: 0 0 100%;
      width: 100%;
      height: 100%;
      scroll-snap-align: start;
      scroll-snap-stop: always;
      display: flex;
      justify-content: center;
      align-items: flex-start;
      padding: 2.8rem 2.2rem;
    }

    .reader-content {
      width: 100%;
      max-width: 620px;
      height: 100%;
      display: flex;
      flex-direction: column;
      gap: 1.2rem;
      overflow-y: auto;
    }

    .reader-title {
      font-size: clamp(1.4rem, 3.8vw, 1.9rem);
      font-weight: normal;
      letter-spacing: 0.8px;
      line-height: 1.3;
      color: #f1ede2;
      text-align: center;
      padding-bottom: 0.7em;
      border-bottom: 1px solid #2a2a2a;
      margin-bottom: 0.4rem;
    }

    .reader-title small {
      display: block;
      font-family: system-ui, -apple-system, sans-serif;
      font-size: 0.52em;
      letter-spacing: 3px;
      text-transform: uppercase;
      color: #7a7a7a;
      margin-bottom: 0.4em;
      font-weight: 500;
    }

    .reader-text-p1 {
      font-size: clamp(0.92rem, 2.2vw, 1.05rem);
      line-height: 1.85;
      letter-spacing: 0.3px;
      color: #c9c5ba;
      text-align: justify;
    }

    .reader-text-p1 p {
      margin-bottom: 1.2rem;
      text-indent: 1.5em;
    }

    .reader-text-p2 {
      font-size: clamp(0.98rem, 2.4vw, 1.12rem);
      line-height: 1.9;
      letter-spacing: 0.3px;
      color: #c9c5ba;
      text-align: justify;
    }

    .reader-text-p2 p {
      margin-bottom: 1.2rem;
      text-indent: 1.5em;
    }

    .reader-dots {
      position: absolute;
      bottom: 14px;
      left: 50%;
      transform: translateX(-50%);
      display: flex;
      gap: 8px;
      z-index: 10;
    }
    .reader-dots span {
      width: 6px;
      height: 6px;
      border-radius: 50%;
      background: #333;
      transition: background 0.3s;
    }
    .reader-dots span.active { background: #d8b4fe; }
  </style>
</head>
<body>

  <!-- CABEÇALHO -->
  <div class="top-header">
    <div class="tag-title">Às quinta-feiras, usamos roxo</div>
    <div class="moon-icon-below" title="Fase da Lua">
      <i data-lucide="moon" size="18" color="#d8b4fe"></i>
    </div>
  </div>

  <!-- CONTEÚDO PRINCIPAL -->
  <div class="main-grid">

    <!-- PERFIL -->
    <aside>
      <div class="retro-window">
        <div class="window-header">
          <span>🦇</span>
        </div>
        <div class="window-body">
          <div class="profile-avatar-container">
            <!-- VETOR DO MORCEGO FOFO -->
            <svg class="profile-avatar-svg" viewBox="0 0 400 400" xmlns="http://www.w3.org/2000/svg">
              <defs>
                <clipPath id="circle">
                  <circle cx="200" cy="200" r="185"/>
                </clipPath>
              </defs>

              <g clip-path="url(#circle)">
                <rect width="400" height="400" fill="#7b3fd4"/>
                <circle cx="80"  cy="90"  r="3" fill="#b18cf0"/>
                <circle cx="320" cy="120" r="3" fill="#b18cf0"/>
                <circle cx="110" cy="320" r="3" fill="#b18cf0"/>
                <circle cx="300" cy="310" r="3" fill="#b18cf0"/>
                <circle cx="200" cy="55"  r="3" fill="#b18cf0"/>
                <circle cx="60"  cy="220" r="3" fill="#b18cf0"/>
                <circle cx="345" cy="230" r="3" fill="#b18cf0"/>
              </g>

              <g transform="translate(200 210)">
                <path d="M -22 -35 Q -70 -75, -110 -40 Q -125 -20, -100 -10 Q -95 10, -70 5 Q -65 30, -40 20 Q -30 40, -12 25 Z" fill="#141414" stroke="#000" stroke-width="2" stroke-linejoin="round"/>
                <path d="M 22 -35 Q 70 -75, 110 -40 Q 125 -20, 100 -10 Q 95 10, 70 5 Q 65 30, 40 20 Q 30 40, 12 25 Z" fill="#141414" stroke="#000" stroke-width="2" stroke-linejoin="round"/>
                <path d="M -32 -55 L -48 -100 L -14 -62 Z" fill="#141414" stroke="#000" stroke-width="2" stroke-linejoin="round"/>
                <path d="M  32 -55 L  48 -100 L  14 -62 Z" fill="#141414" stroke="#000" stroke-width="2" stroke-linejoin="round"/>
                <ellipse cx="0" cy="0" rx="62" ry="62" fill="#141414" stroke="#000" stroke-width="2"/>
                <path d="M -30 -60 L -42 -90 L -20 -64 Z" fill="#7b3fd4" opacity="0.7"/>
                <path d="M  30 -60 L  42 -90 L  20 -64 Z" fill="#7b3fd4" opacity="0.7"/>
                <ellipse cx="-19" cy="-22" rx="12" ry="14" fill="#ffffff"/>
                <ellipse cx=" 19" cy="-22" rx="12" ry="14" fill="#ffffff"/>
                <circle cx="-19" cy="-20" r="7" fill="#000"/>
                <circle cx=" 19" cy="-20" r="7" fill="#000"/>
                <circle cx="-16" cy="-23" r="2.5" fill="#ffffff"/>
                <circle cx=" 22" cy="-23" r="2.5" fill="#ffffff"/>
                <circle cx="-38" cy="-2" r="7" fill="#ff6b9d" opacity="0.55"/>
                <circle cx=" 38" cy="-2" r="7" fill="#ff6b9d" opacity="0.55"/>
                <path d="M -10 4 Q 0 14, 10 4" stroke="#000" stroke-width="2.5" fill="none" stroke-linecap="round"/>
                <path d="M -6 8 L -4 17 L -1 8 Z" fill="#ffffff" stroke="#000" stroke-width="1.5" stroke-linejoin="round"/>
                <path d="M  6 8 L  4 17 L  1 8 Z" fill="#ffffff" stroke="#000" stroke-width="1.5" stroke-linejoin="round"/>
                
                <g fill="#d61032">
                  <path d="M -3 17 Q -6 30, -4 42 Q -3 55, -6 68 Q -8 80, -4 90 Q -2 98, 0 100 Q 2 98, 4 90 Q 7 80, 5 68 Q 3 55, 4 42 Q 6 30, 3 17 Z"/>
                  <path d="M 6 17 Q 12 30, 10 45 Q 8 60, 12 72 Q 14 80, 12 84 Q 10 86, 9 80 Q 6 68, 8 55 Q 10 40, 7 25 Z" opacity="0.95"/>
                  <ellipse cx="-6" cy="52" rx="2.5" ry="4"/>
                  <ellipse cx="9"  cy="76" rx="2" ry="3.5"/>
                </g>
                <ellipse cx="1" cy="92" rx="9" ry="4" fill="#d61032"/>
                <ellipse cx="-30" cy="60" rx="12" ry="8" fill="#141414" stroke="#000" stroke-width="2"/>
                <ellipse cx=" 30" cy="60" rx="12" ry="8" fill="#141414" stroke="#000" stroke-width="2"/>
              </g>
              <circle cx="200" cy="200" r="185" fill="none" stroke="#000" stroke-width="3"/>
            </svg>
          </div>

          <!-- TEXTO DA BIO QUE ALTERNA AO LOGAR -->
          <div class="bio-box" id="bio-dinamica">
            uma vez atravessado o véu, jamais tornareis a contemplar o mundo sob a mesma perspectiva
          </div>

          <div class="user-icon-status-container">
            <button class="user-avatar-btn logged-out" id="user-status-btn" title="Entrar" onclick="clicarIconePerfil()">
              <i data-lucide="cat" id="user-icon-symbol" size="20"></i>
            </button>

            <button class="user-avatar-btn logged-out" title="Notificações" onclick="abrirModalNotificacoes()">
              <i data-lucide="bell" size="18"></i>
            </button>
          </div>
        </div>
      </div>
    </aside>

    <!-- ÁREA PRINCIPAL -->
    <main>
      <!-- CARD LILÁS COM O TEXTO SOLICITADO -->
      <section class="welcome-card-purple">
        <p>
          Espero que estas páginas vos sejam úteis, ainda que apenas por alguns instantes. Que encontrem nelas alguma inspiração, algum conhecimento ou, quem sabe, uma pequena companhia.<br><br>
          Isto é, talvez, um quase-portfólio.<br>
          Mas, acima de tudo, é meu diário.
        </p>

        <div class="button-group">
          <button class="mini-btn" onclick="abrirModalCompartilhar()">compartilhar</button>
          <button class="mini-btn" onclick="abrirModalMensagem()">mensagem</button>
        </div>
      </section>

      <!-- GRELHA INFERIOR (POSTAGENS + FICHAS) -->
      <div class="bottom-grid">
        <div class="retro-window">
          <div class="window-header">
            <span>postagens</span>
          </div>
          <div class="window-body">
            <!-- POSTAGEM 1: OSMAR -->
            <div class="update-item" onclick="abrirLeitorPost('osmar')">
              <span class="update-date" id="data-post-osmar">--/--</span>
              <span>Osmar</span>
            </div>
            <!-- POSTAGEM 2: PROFESSORAS -->
            <div class="update-item" onclick="abrirLeitorPost('professoras')">
              <span class="update-date" id="data-post-professoras">--/--</span>
              <span>Professoras</span>
            </div>
          </div>
        </div>

        <div class="retro-window">
          <div class="window-header">
            <span>fichas</span>
          </div>
          <div class="window-body">
            <!-- FICHA 1: OSMAR -->
            <div class="ficha-card-item" onclick="verFichaCompleta('osmar')">
              <div class="ficha-title">✦ Osmar</div>
              <div class="ficha-sub">Liceu Maranhense - São Luís</div>
            </div>

            <!-- FICHA 2: PROFESSORAS -->
            <div class="ficha-card-item" onclick="verFichaCompleta('professoras')">
              <div class="ficha-title">✦ Professoras</div>
              <div class="ficha-sub">Homenagem às minhas educadoras</div>
            </div>

            <!-- FICHA 3: SOMBRAS DE LILÁS -->
            <div class="ficha-card-item" onclick="verFichaCompleta('sombras')">
              <div class="ficha-title">✦ Sombras de Lilás</div>
              <div class="ficha-sub">Conto • Fantasia Urbana</div>
            </div>
          </div>
        </div>
      </div>
    </main>

  </div>

  <!-- MODAL DE LEITURA DIGITAL DA POSTAGEM -->
  <div class="modal" id="modal-leitor">
    <div class="modal-content reader-modal-body">
      <button class="close-btn" onclick="fecharModal('modal-leitor')">X</button>
      
      <div class="reader" id="reader-container">
        <!-- Páginas injetadas via JS -->
      </div>

      <div class="reader-dots" id="reader-dots">
        <!-- Dots gerados via JS -->
      </div>
    </div>
  </div>

  <!-- MODAL 1: MENSAGEM -->
